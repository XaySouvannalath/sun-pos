{
  "name": "sun-pos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "build:preview": "vite build --config vite.preview.config.ts && node scripts/build-preview.mjs",
    "mock:reset": "node -e \"require('fs').rmSync('.mock-db.json',{force:true});console.log('Mock data reset to src/mock/data/*.json')\""
  },
  "dependencies": {
    "@fontsource/noto-sans-lao": "^5.3.0",
    "lucide-vue-next": "^1.0.0",
    "papaparse": "^5.7.0",
    "pinia": "^4.0.3",
    "read-excel-file": "^9.3.10",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
