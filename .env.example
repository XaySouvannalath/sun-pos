# Copy to .env.local and uncomment ONE option to choose where the app gets its data.
# With nothing set, `npm run dev` serves the mock API at /api/v1 (data in .mock-db.json).

# Option 1 (development): proxy /api to your backend. No CORS setup needed.
# The mock API turns off. Your backend must serve the endpoints under /api/v1.
# VITE_API_PROXY=http://localhost:8080

# Option 2 (production builds, or a backend on another domain): call the API directly.
# The backend must allow this site's origin (CORS). The mock API turns off.
# VITE_API_URL=https://pos.example.com/api/v1

# Option 3: no server at all. The mock API runs inside the browser and saves to localStorage.
# VITE_API_MODE=local
